<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- Deferred foreign keys that could not be created during table creation  -->
    <!-- due to circular dependencies (DEPARTMENTS <-> EMPLOYEES)              -->

    <changeSet id="add-deferred-foreign-keys" author="liquibase-deployer">
        <comment>Add DEPT_MGR_FK: DEPARTMENTS.MANAGER_ID references EMPLOYEES.EMPLOYEE_ID</comment>
        <sqlFile path="TABLES/DEFERRED_FOREIGN_KEYS.sql" relativeToChangelogFile="false" splitStatements="true" stripComments="true"/>
    </changeSet>

</databaseChangeLog>
